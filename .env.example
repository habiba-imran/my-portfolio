# Copy to .env.local and provide values in your local environment.
# Set the server-only values in Vercel Project Settings for Preview and Production.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Upstash Redis REST credentials (server only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile: public site key is safe in browser code; secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Generate independent random secrets of at least 32 characters.
VOICE_SESSION_HMAC_SECRET=

# Upstash QStash delayed cleanup (server only). The URL must be the canonical
# HTTPS deployment URL, ending exactly in /api/voice/cleanup.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
VOICE_CLEANUP_URL=https://your-domain.example/api/voice/cleanup

# Comma-separated exact origins; no trailing slash.
VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://habiba-imran-portfolio.vercel.app
